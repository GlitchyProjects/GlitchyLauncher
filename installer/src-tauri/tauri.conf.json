{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glitchy Launcher Setup",
  "version": "1.3.0",
  "identifier": "ir.glitchy.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Glitchy Launcher Setup",
        "width": 560,
        "height": 700,
        "minWidth": 560,
        "minHeight": 700,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0e1a"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "copyright": "Copyright © 2026 Glitchy Team. All rights reserved.",
    "publisher": "Glitchy Team",
    "shortDescription": "Glitchy Launcher Setup",
    "longDescription": "Glitchy Launcher Setup - Modern Installer for Glitchy Minecraft Launcher",
    "icon": ["icons/icon.ico"]
  }
}
