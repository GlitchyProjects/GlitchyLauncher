{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glitchy Launcher",
  "version": "1.3.1",
  "identifier": "ir.glitchy.launcher",
  "mainBinaryName": "Glitchy Launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "devtools": false,
        "title": "Glitchy Launcher",
        "minWidth": 500,
        "minHeight": 560,
        "transparent": false,
        "backgroundColor": "#0a0e1a",
        "fullscreen": false,
        "center": true,
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "windows": ["main"],
          "identifier": "titlebar",
          "permissions": [
            "core:window:default",
            "core:window:allow-close",
            "core:window:allow-destroy",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-start-dragging",
            "core:window:allow-set-fullscreen",
            "core:window:allow-is-fullscreen",
            "core:event:allow-listen",
            "core:event:default",
            "dialog:default",
            "notification:default",
            "core:resources:default",
            "opener:default",
            "opener:allow-open-path"
          ]
        }
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["glitchyLauncher"]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Glitchy Team. All rights reserved.",
    "publisher": "Glitchy Team",
    "shortDescription": "Glitchy Minecraft Launcher",
    "longDescription": "Glitchy Launcher - A modern, fast Minecraft launcher",
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    }
  }
}
